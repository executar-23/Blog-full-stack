# apps/web — copy to .env.local (never commit real values)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PostgreSQL (local) or Cloudflare Hyperdrive connection string in production (ADR-004)
DATABASE_URL=
# "true" only in production once content exists (scaffold pages are noindex)
ALLOW_INDEXING=false
LOG_LEVEL=info

{
  "$id": "https://creator-led-platform.local/schemas/analytics/batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "events": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "source": {
            "type": "string",
            "enum": ["web", "studio"]
          },
          "path": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^\\/"
          },
          "anonymousId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "funnelStage": {
            "type": "string",
            "enum": [
              "pesquisa",
              "artigo",
              "cms",
              "blog",
              "seo-social",
              "cta",
              "lead",
              "crm-newsletter",
              "produto",
              "analytics"
            ]
          },
          "properties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          }
        },
        "required": ["name", "occurredAt", "source", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["events"],
  "additionalProperties": false
}

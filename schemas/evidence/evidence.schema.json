{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-led-platform.local/schemas/evidence/evidence.schema.json",
  "title": "Evidence",
  "description": "Registro de evidência: fonte/localização, decisão e justificativa objetiva.",
  "type": "object",
  "required": ["id", "kind", "location", "recordedAt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "enum": ["FACT", "DECISION", "ASSUMPTION", "GAP", "CONFLICT"]
    },
    "location": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

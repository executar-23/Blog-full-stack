{
  "name": "@blog/service-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "yarn run -T eslint .",
    "typecheck": "yarn run -T tsc -p tsconfig.json --noEmit",
    "test": "yarn run -T jest --passWithNoTests"
  },
  "devDependencies": {
    "@blog/config": "workspace:^"
  },
  "nx": {
    "tags": [
      "type:service",
      "scope:shared"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          {
            "env": "DATABASE_URL"
          }
        ]
      }
    }
  },
  "dependencies": {
    "@blog/database": "workspace:^",
    "drizzle-orm": "0.45.3"
  }
}
